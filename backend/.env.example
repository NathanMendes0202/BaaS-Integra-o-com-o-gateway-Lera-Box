PORT=3000

# Banco MySQL próprio da aplicação BaaS
DB_HOST=localhost
DB_PORT=3306
DB_USER=baas
DB_PASSWORD=baas
DB_NAME=baas
DB_SYNC=true

# Sessão do lojista (JWT da própria aplicação)
JWT_SECRET=troque-este-segredo-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Chave usada para criptografar token/senha do gateway no banco
ENCRYPTION_KEY=troque-esta-chave-de-criptografia-longa

# Gateway Lera Box
GATEWAY_BASE_URL=https://api.branchpay.com.br/api

# URLs públicas 
PUBLIC_API_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Intervalo em segundos; 
RECONCILE_INTERVAL_SECONDS=60
# Minutos até um Pix gerado e não pago ser marcado como expirado
PIX_EXPIRES_MINUTES=30
